PORT=3000

# MongoDB connection string. The database name in the URI is the one used;
# MONGODB_DB overrides it.
MONGODB_URI=
# MONGODB_DB=

# Only needed if your resolver refuses SRV lookups, which breaks `mongodb+srv://`
# with `querySrv ECONNREFUSED`. Leave unset in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Rate limiting, applied per IP across /api/v1. Defaults to 300 requests
# per 60s window.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# Number of proxy hops in front of the app, so the rate limiter reads the real
# client IP from X-Forwarded-For instead of counting every request as one
# client. Set to 1 behind a single load balancer; leave unset when direct.
# TRUST_PROXY=1

# Only used by `npm run migrate`, which reads the source sqlite files.
# Defaults to ./data
# DATA_DIR=

# DigitalOcean Spaces, used only by `node scripts/upload-images.js`. The server
# never needs these — the image URLs it serves are public.
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# DO_SPACES_CDN_ENDPOINT=https://<bucket>.blr1.cdn.digitaloceanspaces.com
# DO_SPACES_BUCKET=
# DO_SPACES_FOLDER=
