PORT=3000

# MongoDB connection string. The database name in the URI is the one used;
# MONGODB_DB overrides it.
MONGODB_URI=
# MONGODB_DB=

# Only needed if your resolver refuses SRV lookups, which breaks `mongodb+srv://`
# with `querySrv ECONNREFUSED`. Leave unset in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Only used by `npm run migrate`, which reads the source sqlite files.
# Defaults to ./data
# DATA_DIR=
